From 1fe984012135a346e3f676848035d34acaf9a90e Mon Sep 17 00:00:00 2001
From: pylsp-mypy fix <noreply@localhost>
Date: Tue, 10 Nov 2026 07:59:04 +0000
Subject: [PATCH] Fix Windows hang: pass stdin=DEVNULL to mypy/dmypy
 subprocesses

When pylsp runs over stdio, any child spawned with
subprocess.run(..., capture_output=True) and no stdin= inherits pylsp's
stdin - the pipe that carries the LSP protocol from the editor. While
pylsp's reader thread has a blocking read pending on that pipe (i.e.
whenever the server is idle), the child hangs at startup on Windows and
only completes when the next client message arrives. Result: mypy
diagnostics always lag one event behind and appear only after the next
edit or save.

mypy never reads stdin and dmypy detaches when it daemonizes, so nothing
is lost by giving them DEVNULL. ruff is unaffected because it spawns its
process with stdin=PIPE already.

Reproduced on Windows: a parent holding a pipe with a blocked reader
thread plus a child inheriting that pipe as stdin hangs indefinitely;
with stdin=DEVNULL the same child finishes in ~0.1s.
---
 pylsp_mypy/plugin.py | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/pylsp_mypy/plugin.py b/pylsp_mypy/plugin.py
index 634e22d..e637cba 100644
--- a/pylsp_mypy/plugin.py
+++ b/pylsp_mypy/plugin.py
@@ -345,8 +345,8 @@ def get_diagnostics(
             # -> use this mypy
             log.info("executing mypy args = %s on path", args)
             completed_process = subprocess.run(
-                [*mypy_command, *args], capture_output=True, **windows_flag, encoding="utf-8"
-            )
+                [*mypy_command, *args], capture_output=True, **windows_flag, encoding="utf-8",
+            stdin=subprocess.DEVNULL)
             report = completed_process.stdout
             errors = completed_process.stderr
             exit_status = completed_process.returncode
@@ -373,7 +373,7 @@ def get_diagnostics(
                 capture_output=True,
                 **windows_flag,
                 encoding="utf-8",
-            )
+            stdin=subprocess.DEVNULL)
             errors = completed_process.stderr
             exit_status = completed_process.returncode
             if exit_status != 0:
@@ -387,7 +387,7 @@ def get_diagnostics(
                     capture_output=True,
                     **windows_flag,
                     encoding="utf-8",
-                )
+                stdin=subprocess.DEVNULL)
         else:
             # dmypy does not exist on PATH and was not provided by settings,
             # but must exist in the env pylsp-mypy is installed in
@@ -410,8 +410,8 @@ def get_diagnostics(
             # -> use this dmypy
             log.info("dmypy run args = %s via path", args)
             completed_process = subprocess.run(
-                [*dmypy_command, *args], capture_output=True, **windows_flag, encoding="utf-8"
-            )
+                [*dmypy_command, *args], capture_output=True, **windows_flag, encoding="utf-8",
+            stdin=subprocess.DEVNULL)
             report = completed_process.stdout
             errors = completed_process.stderr
             exit_status = completed_process.returncode
@@ -692,7 +692,7 @@ def dmypy_stop(settings: dict[str, Any]) -> None:
             capture_output=True,
             **windows_flag,
             encoding="utf-8",
-        )
+        stdin=subprocess.DEVNULL)
         output, errors = completed_process.stdout, completed_process.stderr
         exit_status = completed_process.returncode
         if exit_status != 0:
@@ -708,7 +708,7 @@ def dmypy_stop(settings: dict[str, Any]) -> None:
                 **windows_flag,
                 encoding="utf-8",
                 check=True,
-            )
+            stdin=subprocess.DEVNULL)
         else:
             log.info("dmypy stopped via path: %s", output.strip())
     else:
